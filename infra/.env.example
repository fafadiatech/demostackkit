# demostackkit environment configuration
# Copy this file to infra/.env and edit as needed.
# Run: demostackkit init

# ── Database ──────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=erpnext

# ── ERPNext Site ─────────────────────────────────────────────────────
SITE_ADMIN_PASSWORD=admin

# ── ERPNext version ──────────────────────────────────────────────────
ERPNEXT_VERSION=v15

# ── HTTP port (default 80, change if conflict) ────────────────────────
HTTP_PORT=80

# ── Seeder overrides (usually leave as default) ───────────────────────
# DSK_SEED_PHASE=all          # all | master | transactions
# DSK_RANDOM_SEED=            # Override per-industry seed for reproducible runs
# DEMOSTACKKIT_VERSION=latest # Docker image tag for seeder containers
